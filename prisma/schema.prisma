generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuditLog {
  id         String   @id @default(uuid())
  projectId  String
  actorId    String
  role       String
  actionType String
  entityType String
  entityId   String
  beforeJson String?
  afterJson  String?
  reason     String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([projectId])
  @@index([projectId, actionType])
  @@index([projectId, createdAt])
  @@index([projectId, actorId, createdAt])
}

model BOQ {
  id              String           @id @default(uuid())
  projectId       String
  orderId         String?
  boqNumber       String?
  name            String?
  description     String?
  category        String?
  scope           String?
  plannedStart    DateTime?
  plannedEnd      DateTime?
  /// Mirrors the parent Purchase Order's Work Order acceptance state (PENDING | ACCEPTED).
  /// Deliberately separate from `status`, which tracks the PMC/Owner BOQ-approval lifecycle.
  workOrderStatus String?
  status          String           @default("DRAFT")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order           Phase?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items           BOQItem[]
  revisions       BOQRevision[]
  raBillLineItems RABillLineItem[]

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([orderId])
}

model BOQItem {
  id             String             @id @default(uuid())
  boqId          String
  description    String
  unit           String
  plannedQty     Float
  rate           Float
  plannedValue   Float
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  boq            BOQ                @relation(fields: [boqId], references: [id], onDelete: Cascade)
  milestoneLinks MilestoneBOQLink[]

  @@index([boqId])
  @@index([boqId, createdAt])
}

model BOQRevision {
  id             String    @id @default(uuid())
  boqId          String
  revisionNumber Int
  reason         String
  changesJson    String
  approvedAt     DateTime?
  approvedById   String?
  createdAt      DateTime  @default(now())
  boq            BOQ       @relation(fields: [boqId], references: [id], onDelete: Cascade)

  @@index([boqId])
  @@index([boqId, revisionNumber])
}

/// A Work Order is issued once per Purchase Order (Phase) and shared by every BOQ under it.
model WorkOrder {
  id                    String              @id @default(uuid())
  projectId             String
  orderId               String              @unique
  number                String
  currentRevisionNumber Int                 @default(0)
  /// DRAFT | ISSUED | PENDING_VENDOR_ACCEPTANCE | ACCEPTED
  status                String              @default("DRAFT")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order                 Phase               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revisions             WorkOrderRevision[]

  @@index([projectId])
}

/// Append-only: revisions are never edited after creation (except the vendor-acceptance stamp
/// on the current revision). Each revision snapshots its full field state so any two revisions
/// can be diffed later, not just against the immediately-prior one.
model WorkOrderRevision {
  id                     String    @id @default(uuid())
  workOrderId            String
  revisionNumber         Int
  issueDate              DateTime
  plannedStart           DateTime?
  plannedEnd             DateTime?
  storageKey             String
  fileName               String
  mimeType               String
  fileSize               Int
  remarks                String?
  /// Required when revisionNumber > 0 (why this revision was created).
  reason                 String?
  /// JSON string: { before, after } full field snapshot — mirrors BOQRevision.changesJson.
  changesJson            String
  /// PENDING | ACCEPTED | REJECTED
  vendorAcceptanceStatus String    @default("PENDING")
  acceptedAt             DateTime?
  acceptedById           String?
  /// Why the vendor pushed back — set together with rejectedAt/rejectedById.
  vendorRemarks          String?
  rejectedAt             DateTime?
  rejectedById           String?
  /// JSON string: narrative/terms/signatory fields captured for the "Generate Work Order PDF"
  /// feature — workDescription, scopeOfWork, completionTimeline, paymentTerms, deliveryTerms,
  /// generalNotes, specialInstructions, termsAndConditions{payment,quality,safety,delayPenalty,
  /// warranty,other}, signatories{preparedBy,vendor,consultant,pmc,client}{name,designation}.
  /// Null until the first PDF is generated for this revision.
  pdfDetailsJson         String?
  createdById            String
  createdAt              DateTime  @default(now())
  workOrder              WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdBy              User      @relation("WorkOrderRevisionCreator", fields: [createdById], references: [id])
  acceptedBy             User?     @relation("WorkOrderRevisionAcceptor", fields: [acceptedById], references: [id])
  rejectedBy             User?     @relation("WorkOrderRevisionRejector", fields: [rejectedById], references: [id])

  @@unique([workOrderId, revisionNumber])
  @@index([workOrderId])
}

/// A Running Account (RA) Bill — a periodic, cumulative contractor bill against a Purchase
/// Order's approved BOQs. Many RA Bills exist per Purchase Order (RA-1, RA-2, RA-3...),
/// sequentially numbered. PMC drafts it (fills this-period quantities against each BOQ), the
/// assigned vendor submits it, PMC/Consultant certifies the measured quantities (certifiedAt
/// = the date work is confirmed executed), CLIENT approves it for payment, then PMC/CLIENT
/// releases payment. Deliberately a single flat `deductions` field (not an itemized
/// retention/TDS/advance breakdown) — mirrors PaymentEligibility.deductions' simplicity.
model RABill {
  id          String   @id @default(uuid())
  projectId   String
  orderId     String
  /// Sequential per-order bill number: 1, 2, 3... (shown in UI as "RA-{billNumber}")
  billNumber  Int
  periodStart DateTime
  periodEnd   DateTime
  /// DRAFT | PENDING_SITE_ENGINEER_REVIEW | PENDING_VENDOR_REVIEW | REVISION_REQUESTED | CERTIFIED | APPROVED | PAID
  status      String   @default("DRAFT")

  /// Sum of lineItems.thisBillAmount at the moment of vendor submission — headline #1.
  submittedValue Float?
  submittedAt    DateTime?
  submittedById  String?

  /// Site Engineer reviews every vendor submission before PMC ever sees it, and may edit the
  /// claimed quantities directly (the vendor has no say in this edit). `siteEngineerReviewedValue`
  /// snapshots the line-item total at the moment they forward it to PMC — the "approved copy"
  /// figure shown back to the vendor.
  siteEngineerReviewedAt    DateTime?
  siteEngineerReviewedById  String?
  siteEngineerReviewedValue Float?
  siteEngineerRemarks       String?

  /// The vendor's binding acknowledgement of the Site Engineer's (possibly edited) figures.
  /// Recorded in parallel with PMC's certification, not a gate in front of it — the vendor
  /// cannot dispute here, only accept.
  vendorAcceptedAt   DateTime?
  vendorAcceptedById String?

  /// PMC/Consultant sends the bill back for correction instead of certifying it.
  revisionRequestedAt   DateTime?
  revisionRequestedById String?
  revisionReason        String?

  /// The date PMC/Consultant certifies measured quantities as executed — the "Finished when"
  /// date shown across the app — headline #2.
  certifiedAt      DateTime?
  certifiedById    String?
  certifiedRemarks String?
  /// The Site Engineer-uploaded measurement sheet (see RABillMeasurementSheet below) PMC/
  /// Consultant picked as the reference when certifying — distinct from the optional fresh
  /// storageKey/fileName attachment below, which is for a separately-uploaded certificate.
  certifiedMeasurementSheetId String? @unique

  /// Sum of lineItems.thisBillAmount at certification, net of `deductions` — headline #3.
  approvedValue Float?
  approvedAt    DateTime?
  approvedById  String?
  deductions    Float     @default(0)

  /// Amount actually paid out — headline #4.
  releasedValue    Float?
  releasedAt       DateTime?
  releasedById     String?
  paymentReference String?

  /// Optional signed measurement-sheet/certificate attachment, mirrors WorkOrderRevision's
  /// file fields.
  storageKey String?
  fileName   String?
  mimeType   String?
  fileSize   Int?

  remarks     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order               Phase            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineItems           RABillLineItem[]
  createdBy           User             @relation("RABillCreator", fields: [createdById], references: [id])
  submittedBy         User?            @relation("RABillSubmitter", fields: [submittedById], references: [id])
  siteEngineerReviewedBy User?         @relation("RABillSiteEngineerReviewer", fields: [siteEngineerReviewedById], references: [id])
  vendorAcceptedBy    User?            @relation("RABillVendorAccepter", fields: [vendorAcceptedById], references: [id])
  revisionRequestedBy User?            @relation("RABillRevisionRequester", fields: [revisionRequestedById], references: [id])
  certifiedBy         User?            @relation("RABillCertifier", fields: [certifiedById], references: [id])
  approvedBy          User?            @relation("RABillApprover", fields: [approvedById], references: [id])
  releasedBy          User?            @relation("RABillPaymentReleaser", fields: [releasedById], references: [id])
  measurementSheets   RABillMeasurementSheet[] @relation("RABillSheets")
  certifiedMeasurementSheet RABillMeasurementSheet? @relation("RABillCertifiedSheet", fields: [certifiedMeasurementSheetId], references: [id], onDelete: SetNull)

  @@unique([orderId, billNumber])
  @@index([projectId])
  @@index([projectId, status])
  @@index([orderId])
  @@index([orderId, billNumber])
}

/// Site Engineer's supporting measurement-sheet attachments — separate from RABill's own single
/// storageKey/fileName (the PMC/Consultant certify-time attachment). A bill can carry several of
/// these (e.g. multiple pages of a measurement book, photos of the measurement), each uploaded
/// while the Site Engineer has the bill for review. Readable by anyone who can view the bill
/// (PMC, Consultant, Client, the assigned Vendor); only the Site Engineer can add one.
model RABillMeasurementSheet {
  id           String   @id @default(uuid())
  raBillId     String
  storageKey   String
  fileName     String
  mimeType     String
  fileSize     Int
  remarks      String?
  uploadedAt   DateTime @default(now())
  uploadedById String
  raBill       RABill   @relation("RABillSheets", fields: [raBillId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  /// Set on the RA Bill that picked this sheet as its certification reference (RABill.
  /// certifiedMeasurementSheetId) — null until then, and there can be at most one.
  certifiedForBill RABill? @relation("RABillCertifiedSheet")

  @@index([raBillId])
}

/// One BOQ line's progress within an RA Bill — snapshotted at creation so each bill is
/// self-contained and never needs to re-walk prior bills to compute cumulative figures, and
/// so later edits to the BOQ don't retroactively change a historical bill.
model RABillLineItem {
  id       String @id @default(uuid())
  raBillId String
  boqId    String

  /// Snapshot of BOQItem fields at time of drafting.
  description   String
  unit          String
  contractedQty Float
  rate          Float

  /// Cumulative qty billed as of the previous certified bill (0 for RA-1).
  previousCumulativeQty Float @default(0)
  /// Qty being billed in this period.
  thisBillQty           Float @default(0)
  /// = thisBillQty * rate
  thisBillAmount        Float @default(0)
  /// = (previousCumulativeQty + thisBillQty) * rate
  cumulativeAmount      Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  raBill RABill @relation(fields: [raBillId], references: [id], onDelete: Cascade)
  boq    BOQ    @relation(fields: [boqId], references: [id])

  @@index([raBillId])
  @@index([boqId])
}

model CustomView {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  name      String
  config    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, name])
  @@index([projectId])
  @@index([userId])
}

model EligibilityEvent {
  id                   String             @id @default(uuid())
  paymentEligibilityId String
  eventType            String
  fromState            String?
  toState              String
  actorId              String
  actorRole            String
  eligibleAmountBefore Float?
  eligibleAmountAfter  Float
  reasonCode           String?
  explanation          String?
  triggerEntityType    String?
  triggerEntityId      String?
  createdAt            DateTime           @default(now())
  actor                User               @relation(fields: [actorId], references: [id])
  paymentEligibility   PaymentEligibility @relation(fields: [paymentEligibilityId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
  @@index([eventType])
  @@index([paymentEligibilityId])
}

model Evidence {
  id            String         @id @default(uuid())
  milestoneId   String
  submittedById String
  submittedAt   DateTime       @default(now())
  qtyOrPercent  Float
  remarks       String?
  frozen        Boolean        @default(false)
  status        String         @default("SUBMITTED")
  reviewedAt    DateTime?
  reviewNote    String?
  /// 'PMC' | 'VENDOR' — who this entry came from. PMC rows are progress updates (qtyOrPercent
  /// holds the activity's percentComplete at the time); Vendor rows are supporting
  /// photos/documents only (qtyOrPercent unused, always 0). Null on legacy rows predating this
  /// distinction. Reuses this table + EvidenceFile as the single append-only Activity History
  /// log instead of a parallel model, so the existing file-serving route needs no changes.
  authorRole    String?
  updatedAt     DateTime       @updatedAt
  milestone     Milestone      @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedBy   User           @relation(fields: [submittedById], references: [id])
  files         EvidenceFile[]

  @@index([milestoneId])
  @@index([status])
  @@index([submittedById])
  @@index([milestoneId, status])
  @@index([submittedById, status])
}

model EvidenceFile {
  id         String   @id @default(uuid())
  evidenceId String
  storageKey String
  fileName   String
  mimeType   String
  size       Int
  filePath   String   @default("")
  createdAt  DateTime @default(now())
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
}

model MilestoneComment {
  id          String    @id @default(uuid())
  milestoneId String
  authorId    String
  role        String
  body        String
  createdAt   DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])

  @@index([milestoneId])
  @@index([milestoneId, createdAt])
}

model FollowUp {
  id             String    @id @default(uuid())
  projectId      String
  type           String
  targetEntity   String
  targetEntityId String
  description    String
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolvedBy     User?     @relation(fields: [resolvedById], references: [id])

  @@index([projectId])
  @@index([resolvedById])
  @@index([status])
  @@index([type])
  @@index([projectId, status, type])
  @@index([projectId, type])
}

model Milestone {
  id                      String                        @id @default(uuid())
  projectId               String
  title                   String
  description             String?
  paymentModel            String                        @default("PROGRESS_BASED")
  plannedStart            DateTime?
  plannedEnd              DateTime?
  actualStart             DateTime?
  actualSubmission        DateTime?
  actualVerification      DateTime?
  // Schedule intelligence fields (Phase 1 additions)
  baselinePlannedEnd      DateTime? // Snapshot of original plannedEnd for baseline comparison
  baselinePlannedStart    DateTime? // Snapshot of original plannedStart
  sortOrder               Int                           @default(0) // Display order in Gantt
  plannedQtyOrPercent     Float                         @default(100)
  retentionPercent        Float                         @default(0)
  advancePercent          Float                         @default(0)
  value                   Float                         @default(0)
  isExtra                 Boolean                       @default(false)
  extraApprovedAt         DateTime?
  extraApprovedById       String?
  state                   String                        @default("DRAFT")
  vendorUserId            String? // Optional: assigned vendor user
  phaseId                 String?
  readyForReview          Boolean                       @default(false) // Vendor-flagged "ready for PMC review" — non-blocking, no state change
  readyForReviewAt        DateTime?
  // Schedule import fields (from MS Project XML/.mpp) — informational, never drive `state`
  wbsCode                 String?
  outlineLevel            Int?
  isMsProjectMilestone    Boolean?
  durationDays            Float?
  percentComplete         Float? // 0-100
  actualEnd               DateTime? // MSPDI ActualFinish (actualStart above is reused for ActualStart)
  actualWorkHours         Float?
  remainingWorkHours      Float?
  scheduleImportId        String?
  /// LOW | NORMAL | HIGH | URGENT — same vocabulary as VendorRequest.priority.
  priority                String                        @default("NORMAL")
  remarks                 String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  evidence                Evidence[]
  comments                MilestoneComment[]
  project                 Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorUser              User?                         @relation("MilestoneVendor", fields: [vendorUserId], references: [id])
  phase                   Phase?                        @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  scheduleImport          ScheduleImport?               @relation(fields: [scheduleImportId], references: [id], onDelete: SetNull)
  boqLinks                MilestoneBOQLink[]
  transitions             MilestoneStateTransition[]
  paymentEligibility      PaymentEligibility?
  verifications           Verification[]
  successorDependencies   MilestoneDependency[]         @relation("DependencySuccessor")
  predecessorDependencies MilestoneDependency[]         @relation("DependencyPredecessor")
  resourceAssignments     MilestoneResourceAssignment[]

  @@index([projectId])
  @@index([state])
  @@index([vendorUserId])
  @@index([extraApprovedById])
  @@index([title])
  @@index([plannedEnd])
  @@index([phaseId])
  @@index([projectId, state])
  @@index([projectId, createdAt])
  @@index([vendorUserId, state])
  @@index([projectId, readyForReview])
}

model MilestoneBOQLink {
  id          String    @id @default(uuid())
  milestoneId String
  boqItemId   String
  plannedQty  Float
  createdAt   DateTime  @default(now())
  boqItem     BOQItem   @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, boqItemId])
  @@index([boqItemId])
  @@index([milestoneId])
}

model MilestoneStateTransition {
  id          String    @id @default(uuid())
  milestoneId String
  fromState   String?
  toState     String
  actorId     String
  role        String
  reason      String?
  createdAt   DateTime  @default(now())
  actor       User      @relation(fields: [actorId], references: [id])
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([milestoneId])
  @@index([milestoneId, createdAt])
}

model PaymentEligibility {
  id                  String             @id @default(uuid())
  milestoneId         String             @unique
  boqValueCompleted   Float              @default(0)
  deductions          Float              @default(0)
  eligibleAmount      Float              @default(0)
  advanceAmount       Float              @default(0)
  remainingAmount     Float              @default(0)
  blockedAmount       Float              @default(0)
  state               String             @default("NOT_DUE")
  dueDate             DateTime?
  blockReasonCode     String?
  blockExplanation    String?
  blockedAt           DateTime?
  blockedByActorId    String?
  markedPaidAt        DateTime?
  markedPaidByActorId String?
  paidExplanation     String?
  lastCalculatedAt    DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  events              EligibilityEvent[]
  milestone           Milestone          @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([dueDate])
  @@index([state])
  @@index([state, dueDate])
}

model Project {
  id               String                 @id @default(uuid())
  name             String
  description      String?
  status           String                 @default("ONGOING")
  metadata         String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  isExampleProject Boolean                @default(false)
  deletedAt        DateTime?
  auditLogs        AuditLog[]
  boqs             BOQ[]
  workOrders       WorkOrder[]
  raBills          RABill[]
  followUps        FollowUp[]
  milestones       Milestone[]
  phases           Phase[]
  roles            ProjectRole[]
  scheduleConfig   ProjectScheduleConfig?
  vendorMetrics    VendorMetrics[]
  projectMetrics   ProjectMetrics[]
  systemEvents     SystemEvent[]
  cashAdjustments  CashAdjustment[]
  privateCosts     PrivateCostEntry[]
  customViews      CustomView[]
  // Architecture module
  drawingSets      DrawingSet[]
  drawingRows      DrawingRow[]
  setRequests      SetRequest[]
  vendorRequests   VendorRequest[]
  projectInvites   ProjectInvite[]
  scheduleImports  ScheduleImport[]
  resources        Resource[]
  // Documents module
  projectDocuments     ProjectDocument[]
  checklists           Checklist[]
  dailyProgressReports DailyProgressReport[]
  reportInsights       ReportInsight[]
  messages             Message[]
}

/// Direct message between two members of the same project — one-on-one only, no role-wide
/// broadcast (that's what VendorRequest/RFI is for). `readAt` is set once when the recipient
/// first opens the thread, not per-message-view granularity.
model Message {
  id          String    @id @default(uuid())
  projectId   String
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender      User                @relation("MessageSender", fields: [senderId], references: [id])
  recipient   User                @relation("MessageRecipient", fields: [recipientId], references: [id])
  attachments MessageAttachment[]

  @@index([projectId])
  @@index([projectId, senderId, recipientId])
  @@index([projectId, recipientId, readAt])
}

/// A file attached to a direct message (e.g. a Site Engineer sharing a document with PMC/Client).
model MessageAttachment {
  id         String  @id @default(uuid())
  messageId  String
  storageKey String
  fileName   String
  mimeType   String
  fileSize   Int
  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// Persisted AI-generated (Claude) narrative content for a Project Report, keyed by
/// project+period+a hash of the condensed data actually sent to the model. Re-viewing or
/// re-downloading the same report reuses this row instead of calling Claude again; a new call
/// (and a new row via upsert) only happens once `dataHash` changes, i.e. the underlying numbers
/// actually moved (new bills, progress updates, checklist results, etc.) since it was last generated.
model ReportInsight {
  id              String   @id @default(uuid())
  projectId       String
  periodType      String // "WEEK" | "MONTH"
  periodStart     DateTime
  periodEnd       DateTime
  dataHash        String
  summary         String
  recommendations String
  scheduleNote    String
  financialNote   String
  qualityNote     String
  resourceNote    String
  riskNote        String
  overviewNote    String
  boqNote         String
  executionNote   String
  costRiskNote    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, periodType, periodStart, periodEnd])
  @@index([projectId])
}

/// Dependency link between two milestones (CPM / Gantt edges)
model MilestoneDependency {
  id             String    @id @default(uuid())
  predecessorId  String
  successorId    String
  /// Dependency type: FS=Finish-to-Start, SS=Start-to-Start, FF=Finish-to-Finish, SF=Start-to-Finish
  dependencyType String    @default("FS")
  lagDays        Float     @default(0)
  createdAt      DateTime  @default(now())
  predecessor    Milestone @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor      Milestone @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

/// Per-project schedule configuration for delay cost estimation and display preferences
model ProjectScheduleConfig {
  id                    String    @id @default(uuid())
  projectId             String    @unique
  /// Project start date used as Gantt origin
  projectStartDate      DateTime?
  /// Estimated daily overhead cost in project currency (for delay cost estimation)
  dailyOverheadCost     Float     @default(0)
  /// Contractual penalty rate per day of delay (fraction, e.g. 0.001 = 0.1%)
  penaltyRatePerDay     Float     @default(0)
  /// Opportunity cost multiplier (optional)
  opportunityCostFactor Float     @default(1.0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectRole {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([projectId, role])
}

model User {
  id                         String                     @id @default(uuid())
  name                       String
  email                      String                     @unique
  hashedPassword             String?
  googleId                   String?                    @unique
  avatarUrl                  String?
  preferredRole              String?
  // Vendor profile fields — generic on User (a vendor is just a User with a VENDOR
  // ProjectRole); null for CLIENT/PMC/other users.
  companyName                String?
  contactPerson              String?
  mobile                     String?
  gstNumber                  String?
  address                    String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  auditLogs                  AuditLog[]
  eligibilityEvents          EligibilityEvent[]
  evidence                   Evidence[]
  milestoneComments          MilestoneComment[]
  followUps                  FollowUp[]
  transitions                MilestoneStateTransition[]
  projectRoles               ProjectRole[]
  verifications              Verification[]
  assignedMilestones         Milestone[]                @relation("MilestoneVendor")
  assignedPhases             Phase[]                    @relation("PhaseVendor")
  vendorMetrics              VendorMetrics[]
  systemEventsActor          SystemEvent[]              @relation("SystemEventActor")
  cashAdjustments            CashAdjustment[]           @relation("CashAdjustmentCreator")
  privateCosts               PrivateCostEntry[]         @relation("PrivateCostCreator")
  // Architecture module
  drawingSetsCreated         DrawingSet[]               @relation("DrawingSetCreator")
  drawingSetsRequested       DrawingSet[]               @relation("DrawingSetRequester")
  drawingSetsPaid            DrawingSet[]               @relation("DrawingSetPaymentReleaser")
  drawingRows                DrawingRow[]               @relation("DrawingRowCreator")
  drawingRowsPaid            DrawingRow[]               @relation("DrawingRowPaymentReleaser")
  drawingVersionsUploaded    DrawingVersion[]           @relation("DrawingVersionUploader")
  drawingVersionsReviewed    DrawingVersion[]           @relation("DrawingVersionReviewer")
  setRequests                SetRequest[]               @relation("SetRequestCreator")
  vendorRequestsSubmitted    VendorRequest[]            @relation("VendorRequestSubmitter")
  vendorRequestsResponded    VendorRequest[]            @relation("VendorRequestResponder")
  vendorRequestFiles         VendorRequestFile[]        @relation("VendorRequestFileUploader")
  projectInvitesSent         ProjectInvite[]            @relation("ProjectInviteInviter")
  scheduleImportsUploaded    ScheduleImport[]
  workOrderRevisionsCreated  WorkOrderRevision[]        @relation("WorkOrderRevisionCreator")
  workOrderRevisionsAccepted WorkOrderRevision[]        @relation("WorkOrderRevisionAcceptor")
  workOrderRevisionsRejected WorkOrderRevision[]        @relation("WorkOrderRevisionRejector")
  raBillsCreated             RABill[]                   @relation("RABillCreator")
  raBillsSubmitted           RABill[]                   @relation("RABillSubmitter")
  raBillsSiteEngineerReviewed RABill[]                  @relation("RABillSiteEngineerReviewer")
  raBillsVendorAccepted     RABill[]                    @relation("RABillVendorAccepter")
  raBillsRevisionRequested   RABill[]                   @relation("RABillRevisionRequester")
  raBillsCertified           RABill[]                   @relation("RABillCertifier")
  raBillsApproved            RABill[]                   @relation("RABillApprover")
  raBillsPaymentReleased     RABill[]                   @relation("RABillPaymentReleaser")
  raBillMeasurementSheetsUploaded RABillMeasurementSheet[]
  // Documents module
  projectDocumentsUploaded   ProjectDocument[]          @relation("ProjectDocumentUploader")
  checklistsCreated          Checklist[]                @relation("ChecklistCreator")
  checklistsSigned           Checklist[]                @relation("ChecklistSigner")
  dprsCreated                DailyProgressReport[]      @relation("DPRCreator")
  dprsSigned                 DailyProgressReport[]      @relation("DPRSigner")
  // Direct messages
  messagesSent               Message[]                  @relation("MessageSender")
  messagesReceived           Message[]                  @relation("MessageRecipient")
}

model Verification {
  id                    String    @id @default(uuid())
  milestoneId           String
  verifiedById          String
  verifiedAt            DateTime  @default(now())
  notes                 String?
  qtyVerified           Float
  valueEligibleComputed Float
  milestone             Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  verifiedBy            User      @relation(fields: [verifiedById], references: [id])

  @@index([milestoneId])
  @@index([milestoneId, verifiedAt])
  @@index([verifiedById])
}

/// Vendor-level metrics snapshot for a project (computed periodically)
model VendorMetrics {
  id                  String   @id @default(uuid())
  projectId           String
  vendorUserId        String
  period              String
  totalMilestones     Int      @default(0)
  completedOnTime     Int      @default(0)
  completedLate       Int      @default(0)
  avgDelayDays        Float    @default(0)
  qualityScore        Float    @default(0)
  escalationCount     Int      @default(0)
  totalValueDelivered Float    @default(0)
  totalValuePaid      Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor              User     @relation(fields: [vendorUserId], references: [id])

  @@unique([projectId, vendorUserId, period])
  @@index([projectId])
  @@index([vendorUserId])
}

/// Project-level aggregated metrics snapshot (computed periodically)
model ProjectMetrics {
  id                 String   @id @default(uuid())
  projectId          String
  period             String
  totalBudget        Float    @default(0)
  spentToDate        Float    @default(0)
  earnedValue        Float    @default(0)
  plannedValue       Float    @default(0)
  costVariance       Float    @default(0)
  scheduleVariance   Float    @default(0)
  cpi                Float    @default(0)
  spi                Float    @default(0)
  milestonesTotal    Int      @default(0)
  milestonesComplete Int      @default(0)
  milestonesOverdue  Int      @default(0)
  healthStatus       String   @default("GREEN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, period])
  @@index([projectId])
}

/// System-wide event log for infrastructure-level events
model SystemEvent {
  id         String   @id @default(uuid())
  eventType  String
  severity   String   @default("INFO")
  actorId    String?
  projectId  String?
  entityType String?
  entityId   String?
  message    String
  metadata   String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("SystemEventActor", fields: [actorId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([severity])
  @@index([actorId])
  @@index([projectId])
  @@index([createdAt])
}

/// Builder-private cash adjustment (credit/debit) for internal financial tracking
model CashAdjustment {
  id          String   @id @default(uuid())
  projectId   String
  description String
  amount      Float
  type        String
  reason      String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("CashAdjustmentCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([createdById])
}

/// Builder-private cost entry not visible to PMC / Vendor / other roles
model PrivateCostEntry {
  id          String    @id @default(uuid())
  projectId   String
  description String
  amount      Float
  category    String
  vendor      String?
  notes       String?
  incurredAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("PrivateCostCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([createdById])
  @@index([category])
}

model Phase {
  id               String          @id @default(uuid())
  projectId        String
  parentPhaseId    String? // self-relation for WBS subphases (Schedule import only — BOQ/Order phases never set this)
  name             String
  description      String?
  outlineLevel     Int? // WBS depth of this phase/subphase, mirrors Milestone.outlineLevel
  sortOrder        Int             @default(0)
  plannedStart     DateTime?
  plannedEnd       DateTime?
  /// PMC's estimate of this Purchase Order's total value, set independent of (and usually
  /// before) the BOQ line items under it — shown to an assigned/invited vendor as an early
  /// indication of scale.
  estimatedCost    Float?
  vendorUserId     String? // Optional: assigned vendor user
  scheduleImportId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduleImport   ScheduleImport? @relation(fields: [scheduleImportId], references: [id], onDelete: SetNull)
  parentPhase      Phase?          @relation("PhaseHierarchy", fields: [parentPhaseId], references: [id], onDelete: Cascade)
  subphases        Phase[]         @relation("PhaseHierarchy")
  vendorUser       User?           @relation("PhaseVendor", fields: [vendorUserId], references: [id])
  boqs             BOQ[]
  workOrder        WorkOrder?
  raBills          RABill[]
  milestones       Milestone[]
  invites          ProjectInvite[]

  @@index([projectId])
  @@index([projectId, sortOrder])
  @@index([parentPhaseId])
  @@index([vendorUserId])
}

// ── Architecture Module ───────────────────────────────────────────────────────

/// A set of drawings (e.g. "Working Drawing Set 1") with a cost and lifecycle
model DrawingSet {
  id                String    @id @default(uuid())
  projectId         String
  name              String
  description       String?
  cost              Float     @default(0)
  currency          String    @default("INR")
  /// DRAFT | SUBMITTED_TO_PMC | REQUESTED | IN_PROGRESS | DELIVERED | APPROVED | PAID
  status            String    @default("DRAFT")
  createdById       String
  requestedById     String?
  requestedAt       DateTime?
  dueDate           DateTime?
  deliveredAt       DateTime?
  approvedAt        DateTime?
  paidAt            DateTime?
  paymentReleasedBy String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("DrawingSetCreator", fields: [createdById], references: [id])
  requestedBy     User?        @relation("DrawingSetRequester", fields: [requestedById], references: [id])
  paymentReleaser User?        @relation("DrawingSetPaymentReleaser", fields: [paymentReleasedBy], references: [id])
  rows            DrawingRow[]
  requests        SetRequest[]

  @@index([projectId])
  @@index([createdById])
  @@index([projectId, status])
}

/// A single drawing row — one entry in the master drawing register
model DrawingRow {
  id          String    @id @default(uuid())
  projectId   String
  setId       String?
  serialNo    Int
  category    String
  name        String
  /// BASEMENT | GROUND_FLOOR | FIRST_FLOOR | SECOND_FLOOR | TERRACE | ALL_FLOORS
  floor       String    @default("ALL_FLOORS")
  description String?
  /// PENDING | SUBMITTED | APPROVED | REJECTED
  status      String    @default("PENDING")
  dueDate     DateTime?
  createdById String
  /// Per-drawing payment release (OWNER)
  paidAt      DateTime?
  paidById    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  set       DrawingSet?      @relation(fields: [setId], references: [id], onDelete: SetNull)
  createdBy User             @relation("DrawingRowCreator", fields: [createdById], references: [id])
  paidBy    User?            @relation("DrawingRowPaymentReleaser", fields: [paidById], references: [id])
  versions  DrawingVersion[]

  @@index([projectId])
  @@index([setId])
  @@index([projectId, status])
  @@index([projectId, serialNo])
}

/// A specific version of a drawing (v0, v1, v2 …)
model DrawingVersion {
  id              String    @id @default(uuid())
  drawingRowId    String
  versionNumber   Int
  /// PDF | URL
  uploadType      String    @default("PDF")
  fileUrl         String
  fileName        String?
  fileSizeKb      Int?
  uploadedById    String
  uploadedAt      DateTime  @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  /// PENDING | APPROVED | REJECTED
  reviewStatus    String    @default("PENDING")
  rejectionReason String?
  isCurrent       Boolean   @default(true)

  drawingRow DrawingRow @relation(fields: [drawingRowId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("DrawingVersionUploader", fields: [uploadedById], references: [id])
  reviewedBy User?      @relation("DrawingVersionReviewer", fields: [reviewedById], references: [id])

  @@index([drawingRowId])
  @@index([uploadedById])
  @@index([drawingRowId, isCurrent])
  @@index([drawingRowId, versionNumber])
}

/// A formal PMC request for a drawing set
model SetRequest {
  id            String    @id @default(uuid())
  setId         String
  projectId     String
  requestedById String
  requestedAt   DateTime  @default(now())
  dueDate       DateTime?
  note          String?
  /// PENDING | ACCEPTED | DECLINED
  status        String    @default("PENDING")

  set         DrawingSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("SetRequestCreator", fields: [requestedById], references: [id])

  @@index([setId])
  @@index([projectId])
}

/// A formal request or submission between any project parties (bidirectional)
model VendorRequest {
  id            String    @id @default(uuid())
  projectId     String
  submittedById String
  senderRole    String    @default("VENDOR") // VENDOR | PMC | CONSULTANT | OWNER
  category      String    @default("REQUEST") // REQUEST | SUBMISSION
  title         String
  description   String
  type          String    @default("RFI")
  priority      String    @default("NORMAL")
  dueDate       DateTime?
  sendTo        String    @default("PMC") // PMC | CONSULTANT | OWNER | VENDOR | BOTH | ALL
  refNumber     String?
  status        String    @default("PENDING")
  responseNote  String?
  respondedById String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User                @relation("VendorRequestSubmitter", fields: [submittedById], references: [id])
  respondedBy User?               @relation("VendorRequestResponder", fields: [respondedById], references: [id])
  files       VendorRequestFile[]

  @@index([projectId])
  @@index([submittedById])
  @@index([senderRole])
  @@index([status])
  @@index([category])
  @@index([sendTo])
  @@index([projectId, status])
  @@index([projectId, category])
  @@index([projectId, createdAt])
  @@index([projectId, sendTo])
  @@index([projectId, submittedById])
}

/// Pending invitation for a user who is not yet on the platform
model ProjectInvite {
  id          String   @id @default(uuid())
  projectId   String
  email       String
  role        String
  /// Set only for a VENDOR invite sent via the "Assign to Purchase Order" onboarding option —
  /// on acceptance, the new user is set as this Phase's vendorUserId in the same transaction
  /// that grants their ProjectRole, so they land already assigned instead of needing a
  /// separate PMC step afterward. Null for a plain email invite (today's only option pre-this).
  phaseId     String?
  token       String   @unique
  status      String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("ProjectInviteInviter", fields: [invitedById], references: [id])
  phase     Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@unique([projectId, email])
  @@index([projectId])
  @@index([email])
  @@index([token])
  @@index([phaseId])
  @@index([status])
}

/// File attachment for a vendor request
model VendorRequestFile {
  id           String   @id @default(uuid())
  requestId    String
  storageKey   String
  fileName     String
  mimeType     String
  fileSize     Int
  uploadedById String
  createdAt    DateTime @default(now())

  request    VendorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation("VendorRequestFileUploader", fields: [uploadedById], references: [id])

  @@index([requestId])
}

// ── Schedule Import (MS Project XML / .mpp) ───────────────────────────────────

/// One uploaded schedule file (MSPDI XML export or raw .mpp) and its extraction run.
model ScheduleImport {
  id                String    @id @default(uuid())
  projectId         String
  uploadedById      String
  fileName          String
  mimeType          String
  fileSize          Int
  storageKey        String // raw uploaded file bytes, via the fileStorage adapter
  sourceFormat      String // "XML" | "MPP"
  status            String    @default("PENDING") // PENDING|PARSING|PARSED|FAILED|CONFIRMED
  errorMessage      String?   @db.Text
  extractedDataJson String?   @db.Text // cached parse result, consumed by the confirm step
  phasesFound       Int       @default(0)
  milestonesFound   Int       @default(0)
  dependenciesFound Int       @default(0)
  resourcesFound    Int       @default(0)
  parsedAt          DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation(fields: [uploadedById], references: [id])
  phases     Phase[]
  milestones Milestone[]
  resources  Resource[]

  @@index([projectId, createdAt])
}

/// Lightweight resource capture from an imported schedule (Civil Engineer, Excavator, Crane, ...).
/// Display-only for now — deliberately not a full resource-management module.
model Resource {
  id               String   @id @default(uuid())
  projectId        String
  scheduleImportId String?
  name             String
  type             String? // free text, e.g. "Labor" | "Equipment" | "Material"
  createdAt        DateTime @default(now())

  project        Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduleImport ScheduleImport?               @relation(fields: [scheduleImportId], references: [id], onDelete: SetNull)
  assignments    MilestoneResourceAssignment[]

  @@index([projectId])
}

/// Join table: which resources are assigned to which milestone/task, and how much.
model MilestoneResourceAssignment {
  id          String   @id @default(uuid())
  milestoneId String
  resourceId  String
  units       Float    @default(100) // % allocation, 100 = 1 FTE
  workHours   Float?
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  resource  Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, resourceId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Documents module — Specs / Other Docs / Checklists / DPR
// ═══════════════════════════════════════════════════════════════════════════

/// A single upload event in the Specs or Other Docs library — append-only, mirrors
/// Evidence/EvidenceFile's field naming rather than DrawingVersion's isCurrent-flag
/// versioning, since there's no "supersedes" concept here, just a browsable library.
model ProjectDocument {
  id           String    @id @default(uuid())
  projectId    String
  category     String // 'SPEC' | 'OTHER'
  title        String
  description  String?
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User                  @relation("ProjectDocumentUploader", fields: [uploadedById], references: [id])
  files      ProjectDocumentFile[]

  @@index([projectId, category, createdAt])
}

model ProjectDocumentFile {
  id         String   @id @default(uuid())
  documentId String
  storageKey String
  fileName   String
  mimeType   String
  size       Int
  /// The actual return value of fileStorage.save() — required to read the file back (e.g.
  /// Vercel Blob's save() returns a full URL, different from the storageKey passed in).
  /// Mirrors EvidenceFile's identical filePath field for the same reason.
  filePath   String   @default("")
  createdAt  DateTime @default(now())

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

/// PMC-defined inspection checklist (e.g. Waterproofing, Internal & External MEP work) tied to
/// a drawing reference. Site Engineer marks each check point OK/Not OK/N.A. with remarks, then
/// digitally signs — which freezes the record. Project/Client/Location are deliberately not
/// stored here; resolved at read/PDF time from Project + ProjectRole, same as RA Bill PDFs do.
model Checklist {
  id                   String    @id @default(uuid())
  projectId            String
  title                String // free text, PMC types this — not an enum
  docRefNo             String // "CHK-001", auto-numbered per project
  referenceDrawingNo   String
  status               String    @default("DRAFT") // DRAFT | IN_PROGRESS | SIGNED
  certificationRemarks String?
  createdById          String
  signedAt             DateTime?
  signedByActorId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User            @relation("ChecklistCreator", fields: [createdById], references: [id])
  signedBy  User?           @relation("ChecklistSigner", fields: [signedByActorId], references: [id])
  items     ChecklistItem[]

  @@unique([projectId, docRefNo])
  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  checklistId String
  sortOrder   Int      @default(0)
  description String // the check point text, PMC-defined
  result      String? // 'OK' | 'NOT_OK' | 'NA' — null until Site Engineer fills it
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, sortOrder])
}

/// Site Engineer's Daily Progress Report — one per project per calendar day. reportDate is a
/// date-only string ("YYYY-MM-DD"), mirroring ProjectMetrics.period's deliberate use of String
/// over DateTime to sidestep timezone/granularity issues on the uniqueness constraint.
model DailyProgressReport {
  id              String    @id @default(uuid())
  projectId       String
  reportDate      String
  periodFrom      String?
  periodTo        String?
  docRefNo        String // "DPR-001"
  status          String    @default("DRAFT") // DRAFT | SIGNED
  /// Free text, separate from Day's Highlights — for flagging urgent/critical issues that
  /// need PMC/Client attention (e.g. safety concerns, blockers), not just routine progress notes.
  criticalIssues  String?
  createdById     String
  signedAt        DateTime?
  signedByActorId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("DPRCreator", fields: [createdById], references: [id])
  signedBy        User?               @relation("DPRSigner", fields: [signedByActorId], references: [id])
  procurementRows DPRProcurementRow[]
  manpowerRows    DPRManpowerRow[]
  highlights      DPRHighlight[]
  photos          DPRPhoto[]

  @@unique([projectId, reportDate])
  @@index([projectId, status])
}

model DPRProcurementRow {
  id                         String   @id @default(uuid())
  dprId                      String
  sortOrder                  Int      @default(0)
  materialName                String
  description                 String?
  unit                        String
  alreadyReceived             Float    @default(0)
  receivedThisWeek            Float    @default(0)
  cumulativeReceivedTillDate  Float    @default(0)
  consumedTillDate            Float    @default(0)
  balanceAtSite               Float    @default(0)
  additionalRequirement       String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  dpr DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@index([dprId, sortOrder])
}

/// One row per labour trade within a vendor group for a given DPR (e.g. Vanbros -> Engineer,
/// Vanbros -> Mason). vendorName is free text, not an FK to a Vendor User/ProjectRole, since
/// DPR subcontractor names don't always correspond to onboarded platform accounts.
model DPRManpowerRow {
  id           String   @id @default(uuid())
  dprId        String
  sortOrder    Int      @default(0)
  vendorName   String
  tradeName    String
  unit         String   @default("")
  actualCount  Int      @default(0)
  plannedCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dpr DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@index([dprId, vendorName])
  @@index([dprId, sortOrder])
}

model DPRHighlight {
  id          String   @id @default(uuid())
  dprId       String
  sortOrder   Int      @default(0)
  description String
  createdAt   DateTime @default(now())

  dpr DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@index([dprId, sortOrder])
}

/// Site photos attached to a DPR, each with its own caption — mirrors ProjectDocumentFile's
/// field shape (storageKey + filePath, since e.g. Vercel Blob's save() return value differs
/// from the key passed in) plus a per-photo remarks/caption field.
model DPRPhoto {
  id         String   @id @default(uuid())
  dprId      String
  storageKey String
  filePath   String   @default("")
  fileName   String
  mimeType   String
  size       Int
  remarks    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  dpr DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@index([dprId, sortOrder])
}
